{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker4s/master/stryker4s-core/src/main/resources/META-INF/schema/stryker-core.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress", "dashboard"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "!src/**/index.ts",
    "!src/**/*.d.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "concurrency": 4,
  "timeoutMS": 10000,
  "timeoutFactor": 1.5,
  "incremental": true,
  "incrementalFile": ".stryker-cache/incremental.json",
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    ".stryker-tmp"
  ],
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "disableTypeChecks": "src/**/*.ts"
}
