#!/usr/bin/env bpftrace

// === Process Execution ===
// Trace all new process executions with args
// bpftrace -e 'tracepoint:syscalls:sys_enter_execve { printf("%d %s %s\n", pid, comm, str(args.filename)); }'

// === TCP Connection Latency ===
// Histogram of TCP connect() latency in microseconds
tracepoint:syscalls:sys_enter_connect
/comm != "bpftrace"/
{
    @connect_start[tid] = nsecs;
}

tracepoint:syscalls:sys_exit_connect
/@connect_start[tid]/
{
    $dur = (nsecs - @connect_start[tid]) / 1000;
    @tcp_connect_us = hist($dur);
    delete(@connect_start[tid]);
}

// === Block I/O Latency ===
// Latency histogram for block device I/O
tracepoint:block:block_rq_issue
{
    @bio_start[args.dev, args.sector] = nsecs;
}

tracepoint:block:block_rq_complete
/@bio_start[args.dev, args.sector]/
{
    $dur = (nsecs - @bio_start[args.dev, args.sector]) / 1000;
    @bio_latency_us = hist($dur);
    delete(@bio_start[args.dev, args.sector]);
}

// === Syscall Count by Process ===
// Top processes by syscall count (sample for 10s)
// bpftrace -e 'tracepoint:raw_syscalls:sys_enter { @[comm] = count(); } interval:s:10 { exit(); }'

// === File Open Trace ===
// What files are being opened and by whom
// bpftrace -e 'tracepoint:syscalls:sys_enter_openat { printf("%s %d %s\n", comm, pid, str(args.filename)); }'

// === Read Size Distribution ===
// Distribution of read() sizes
// bpftrace -e 'tracepoint:syscalls:sys_exit_read /args.ret > 0/ { @read_bytes = hist(args.ret); }'

// === Memory Allocation ===
// Track large allocations (>1MB) via mmap
// bpftrace -e 'tracepoint:syscalls:sys_enter_mmap /args.len > 1048576/ { printf("%s pid=%d size=%dMB\n", comm, pid, args.len / 1048576); }'

// === Scheduler Latency ===
// How long tasks wait in the run queue
tracepoint:sched:sched_wakeup
{
    @runq_start[args.pid] = nsecs;
}

tracepoint:sched:sched_switch
/@runq_start[args.next_pid]/
{
    $dur = (nsecs - @runq_start[args.next_pid]) / 1000;
    @runq_latency_us = hist($dur);
    delete(@runq_start[args.next_pid]);
}

// === DNS Lookup Latency ===
// Trace getaddrinfo latency
// bpftrace -e 'uprobe:/lib/x86_64-linux-gnu/libc.so.6:getaddrinfo { @start[tid] = nsecs; } uretprobe:/lib/x86_64-linux-gnu/libc.so.6:getaddrinfo /@start[tid]/ { @dns_us = hist((nsecs - @start[tid]) / 1000); delete(@start[tid]); }'

// === Page Faults ===
// Page fault count by process
// bpftrace -e 'software:page-fault:1 { @pf[comm] = count(); } interval:s:10 { exit(); }'

// === OOM Kills ===
// Trace OOM killer events
// bpftrace -e 'kprobe:oom_kill_process { printf("OOM kill: %s pid=%d\n", comm, pid); }'

// === CPU Sampling Profile ===
// 99Hz CPU profiling (use with flamegraph.pl)
// bpftrace -e 'profile:hz:99 { @[kstack] = count(); } interval:s:30 { exit(); }'

// === Context Switches ===
// Count voluntary vs involuntary context switches
// bpftrace -e 'tracepoint:sched:sched_switch { @cs[args.prev_state == 0 ? "involuntary" : "voluntary"] = count(); }'

// Print summary on Ctrl-C (for inline probes above)
END
{
    clear(@connect_start);
    clear(@bio_start);
    clear(@runq_start);
}
