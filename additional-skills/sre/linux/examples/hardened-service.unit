[Unit]
Description=Application Service (Hardened)
Documentation=https://example.com/docs
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
ExecStart=/usr/local/bin/myapp --config /etc/myapp/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
WatchdogSec=30
TimeoutStartSec=30
TimeoutStopSec=30

User=myapp
Group=myapp
DynamicUser=false

WorkingDirectory=/var/lib/myapp
StateDirectory=myapp
CacheDirectory=myapp
LogsDirectory=myapp

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateUsers=true
PrivateIPC=true

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid

ReadWritePaths=/var/lib/myapp
ReadOnlyPaths=/etc/myapp

NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SocketBindAllow=tcp:8080
SocketBindDeny=any

SystemCallFilter=@system-service
SystemCallFilter=~@mount @debug @reboot @swap @raw-io @obsolete @cpu-emulation @resources
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM

LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
UMask=0077

IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=10.0.0.0/8
IPAddressAllow=172.16.0.0/12
IPAddressAllow=192.168.0.0/16

MemoryMax=2G
MemoryHigh=1536M
CPUQuota=200%
TasksMax=256
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=myapp
LogLevelMax=info

LoadCredential=db-password:/etc/credstore/myapp-db-password
Environment=CREDENTIALS_DIR=%d

[Install]
WantedBy=multi-user.target
