{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "zara",
  "lsp": true,
  "autoupdate": true,
  "instructions": [
    ".opencode/instructions/system.md",
    ".opencode/instructions/system-extended.md"
  ],
  "agent": {
    "zara": {
      "description": "Zara — senior engineering partner, warm and ambitious, speaks your language naturally",
      "mode": "primary",
      "prompt": "{file:.opencode/agent/zara.md}",
      "temperature": 0.3
    },
    "plan": {
      "description": "Sketch — Zara's planning mode, analysis and design without changes",
      "mode": "primary",
      "prompt": "{file:.opencode/agent/sketch.md}",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "atlas": {
      "description": "Atlas — architecture specialist, system design, patterns, tradeoffs",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/atlas.md}",
      "temperature": 0.2,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "scout": {
      "description": "Scout — requirements clarifier, turns vague requests into specs (read-only)",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/scout.md}",
      "temperature": 0.2,
      "steps": 10,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "lens": {
      "description": "Lens — code review specialist, quality, smells, refactoring",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/lens.md}",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "probe": {
      "description": "Probe — testing specialist, strategy, coverage, test design",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/probe.md}",
      "temperature": 0.2,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "shield": {
      "description": "Shield — security specialist, threat modeling, secure design, auth",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/shield.md}",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "pulse": {
      "description": "Pulse — delivery specialist, shipping, velocity, tech debt",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/pulse.md}",
      "temperature": 0.3,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "hive": {
      "description": "Hive — swarm coordinator, decomposes, delegates, synthesizes",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/hive.md}",
      "temperature": 0.2,
      "steps": 20,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "rhythm": {
      "description": "Rhythm — loop engineering partner, iterative workflows, verification, failure modes",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/rhythm.md}",
      "temperature": 0.2,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "forge": {
      "description": "Forge — implementation specialist, plan -> code -> verify -> ship. Execution-focused.",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/forge.md}",
      "temperature": 0.2,
      "steps": 30,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "refiner": {
      "description": "Refiner — answer quality specialist, evaluate -> decompose -> research -> refine -> compare",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/refiner.md}",
      "temperature": 0.2,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "compaction": {
      "description": "Context compaction — preserves critical state when summarizing long conversations",
      "prompt": "{file:.opencode/agent/compaction.md}",
      "temperature": 0.1,
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "command": {
    "code": {
      "template": "{file:.opencode/commands/code.md}"
    },
    "review": {
      "template": "{file:.opencode/commands/review.md}",
      "agent": "lens"
    },
    "swarm": {
      "template": "{file:.opencode/commands/swarm.md}",
      "agent": "hive"
    },
    "think": {
      "template": "{file:.opencode/commands/think.md}"
    },
    "handoff": {
      "template": "{file:.opencode/commands/handoff.md}"
    },
    "resume": {
      "template": "{file:.opencode/commands/resume.md}"
    },
    "harness": {
      "template": "{file:.opencode/commands/harness.md}"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "x-api-key": "{env:CONTEXT7_API_KEY}"
      }
    },
    "Orchestrator": {
      "type": "local",
      "command": [
        "./mcp/zarust-memory/target/release/zmem-mcp.exe"
      ],
      "timeout": 30000,
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "git checkout main*": "ask",
      "git checkout master*": "ask",
      "git checkout prod*": "ask",
      "git checkout dev*": "ask",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny"
    }
  }
}
