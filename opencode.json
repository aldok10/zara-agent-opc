{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "zara",
  "lsp": true,
  "autoupdate": true,
  "instructions": [
    ".opencode/instructions/system.md"
  ],
  "agent": {
    "zara": {
      "description": "Zara \u2014 senior engineering partner, warm and ambitious, speaks your language naturally",
      "mode": "primary",
      "prompt": "{file:.opencode/agent/zara.md}",
      "temperature": 0.3
    },
    "plan": {
      "description": "Sketch \u2014 Zara's planning mode, analysis and design without changes",
      "mode": "primary",
      "prompt": "{file:.opencode/agent/sketch.md}",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "architect": {
      "description": "Atlas \u2014 architecture specialist, system design, patterns, tradeoffs",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/atlas.md}",
      "temperature": 0.2,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "requirements-clarifier": {
      "description": "Scout \u2014 requirements clarifier, turns vague requests into specs (read-only)",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/scout.md}",
      "temperature": 0.2,
      "steps": 10,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "code-reviewer": {
      "description": "Lens \u2014 code review specialist, quality, smells, refactoring",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/lens.md}",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "testing-lead": {
      "description": "Probe \u2014 testing specialist, strategy, coverage, test design",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/probe.md}",
      "temperature": 0.2,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "security-reviewer": {
      "description": "Shield \u2014 security specialist, threat modeling, secure design, auth",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/shield.md}",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "delivery-lead": {
      "description": "Pulse \u2014 delivery specialist, shipping, velocity, tech debt",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/pulse.md}",
      "temperature": 0.3,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "swarm": {
      "description": "Hive \u2014 swarm coordinator, decomposes, delegates, synthesizes",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/hive.md}",
      "temperature": 0.2,
      "steps": 20,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "loop-engineer": {
      "description": "Rhythm \u2014 loop engineering partner, iterative workflows, verification, failure modes",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/rhythm.md}",
      "temperature": 0.2,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "implementation": {
      "description": "Forge \u2014 implementation specialist, plan -> code -> verify -> ship. Execution-focused.",
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/forge.md}",
      "temperature": 0.2,
      "steps": 30,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "compaction": {
      "description": "Context compaction \u2014 preserves critical state when summarizing long conversations",
      "prompt": "{file:.opencode/agent/compaction.md}",
      "temperature": 0.1
    }
  },
  "command": {
    "code": {
      "template": "{file:.opencode/commands/code.md}"
    },
    "review": {
      "template": "{file:.opencode/commands/review.md}",
      "agent": "code-reviewer"
    },
    "swarm": {
      "template": "{file:.opencode/commands/swarm.md}",
      "agent": "swarm"
    },
    "think": {
      "template": "{file:.opencode/commands/think.md}"
    },
    "handoff": {
      "template": "{file:.opencode/commands/handoff.md}"
    },
    "resume": {
      "template": "{file:.opencode/commands/resume.md}"
    }
  },
  "plugin": [
    ".opencode/plugin/zara.mjs"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "x-api-key": "{env:CONTEXT7_API_KEY}"
      }
    },
    "Orchestrator": {
      "type": "local",
      "command": [
        "node",
        "--experimental-sqlite",
        "tools/mcp/index.mjs"
      ],
      "timeout": 30000,
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "git checkout main*": "ask",
      "git checkout master*": "ask",
      "git checkout prod*": "ask",
      "git checkout dev*": "ask",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny"
    }
  }
}